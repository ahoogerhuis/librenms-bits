# docker-compose.yml override values for a real deployment.
#
# Copy to .env (gitignored, never committed) and fill in this site's
# real values. docker-compose.yml's committed defaults are generic
# placeholders so the file reads correctly as a template for any
# adopter -- real site-specific values belong here, not in the
# committed compose file.

# Where this site's real proxy image is built/pushed to.
WINRM_PROXY_IMAGE=git.example.com/yourorg/librenms-winrm-proxy:latest

# The real Kerberos principal for this site's proxy service account,
# matching the keytab mounted at WINRM_PROXY_KEYTAB.
WINRM_PROXY_PRINCIPAL=svc-winrmproxy@EXAMPLE.LOCAL
